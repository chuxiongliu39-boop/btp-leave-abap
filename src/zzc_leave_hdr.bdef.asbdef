projection implementation in class ZZBP_C_LEAVE_HDR unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZZC_LEAVE_HDR alias LeaveHdr
extensible
use etag
{
  use create;
  use update;
  use delete;
  use action startSbpa;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
//  use determination CalculateLeaveDays;
//  use validation ValidateDates;

  use association _LeaveItem { create; with draft; }
}

define behavior for ZZC_LEAVE_ITEM alias LeaveItem
{
  use update;
  use delete;

  use association _LeaveHdr;
}